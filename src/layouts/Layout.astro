---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const {title,description,current=''}=Astro.props;
---
<!doctype html><html lang="en-GB"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width"><meta name="description" content={description}><meta name="theme-color" content="#0A2E6E"><link rel="icon" href="/favicon.svg"><title>{title}</title></head><body><Header current={current}/><main><slot/></main><Footer/></body></html>
