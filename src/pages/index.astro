---
import Layout from '../layouts/Layout.astro';
const services=[['💧','Leaks & repairs','Fast diagnosis and practical repairs for dripping taps, leaking pipes and common plumbing faults.'],['↯','Blocked drains','Help with stubborn household blockages and advice to reduce repeat problems.'],['♨','Boiler repairs','Reliable fault finding and repair support to get heating and hot water working again.'],['▣','Bathroom installations','Careful plumbing for bathroom upgrades, replacements and complete installations.']];
---
<Layout title="SwiftFix Plumbing | Local Plumber in Leicester" description="Reliable plumbing repairs, emergency plumbing and installations for homeowners and landlords across Leicester." current="/">
<section class="hero"><div class="hero-grid"><div class="hero-copy"><span class="eyebrow">Your local Leicester plumber</span><h1>Plumbing sorted. Quickly and properly.</h1><p>Dependable repairs and installations for homeowners and landlords, from urgent leaks to complete bathroom projects.</p><div class="hero-actions"><a class="btn" href="/contact/#quote">Request a quote</a><a class="btn secondary" href="tel:01160000000">Call for emergency help</a></div><div class="trust-row"><span>✓ Clear communication</span><span>✓ Quality workmanship</span><span>✓ Leicester-based service</span></div></div><div class="hero-media"><img src="/images/swiftfix-kitchen-plumber.webp" width="1536" height="1024" alt="Professional plumber repairing pipework beneath a modern kitchen sink"></div></div></section>
<section><div class="container"><div class="section-head"><span class="eyebrow">Plumbing services</span><h2>Practical help for repairs, emergencies and improvements.</h2><p>SwiftFix provides a straightforward local service for everyday plumbing problems and planned installation work.</p></div><div class="grid">{services.map(([icon,title,text])=><article class="card"><span class="card-icon">{icon}</span><h3>{title}</h3><p>{text}</p></article>)}</div></div></section>
<section class="band"><div class="container split"><img src="/images/swiftfix-bathroom-plumber.webp" width="1536" height="1024" alt="Plumber carefully checking a modern bathroom tap installation"><div><span class="eyebrow">Why SwiftFix</span><h2>A professional plumber you can feel confident calling.</h2><p>We keep the process clear from the first conversation: understand the issue, explain the work and complete it with care.</p><div class="ticks"><span>Responsive help when plumbing problems cannot wait</span><span>Support for homeowners and residential landlords</span><span>Repairs and installations completed with care</span><span>Local service across Leicester</span></div><a class="btn navy" href="/about/">More about SwiftFix</a></div></div></section>
</Layout>
