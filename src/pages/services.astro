---
import Layout from '../layouts/Layout.astro';
const items=[['Leaks and repairs','From leaking pipes and dripping taps to faulty toilets and plumbing connections, we identify the problem and explain the practical repair options.'],['Blocked drains','Help clearing common household blockages, checking the likely cause and advising on ways to reduce future disruption.'],['Boiler repairs','Fault-finding and repair support when your boiler, heating or hot water is not working as expected.'],['Bathroom installations','Plumbing support for bathroom refurbishments, fixture replacements and full installations, delivered with careful attention to the finish.']];
---
<Layout title="Plumbing Services in Leicester | SwiftFix Plumbing" description="Explore SwiftFix Plumbing services in Leicester, including leaks, blocked drains, boiler repairs and bathroom installations." current="/services/"><section class="page-hero"><div class="container"><span class="eyebrow">Services</span><h1>Reliable plumbing for everyday problems and planned projects.</h1><p>Clear, professional help for Leicester homes and rental properties.</p></div></section><section><div class="container"><div class="service-list">{items.map(([title,text],i)=><article class="service-row"><span class="card-icon">{i+1}</span><div><strong>{title}</strong><p>{text}</p></div></article>)}</div><div style="margin-top:34px"><a class="btn" href="/contact/#quote">Request a quote</a></div></div></section></Layout>
