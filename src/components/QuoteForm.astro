<form class="quote-form" id="quote" action="#" method="post"><label>Name<input name="name" autocomplete="name" required></label><label>Email<input name="email" type="email" autocomplete="email" required></label><label>Phone<input name="phone" type="tel" autocomplete="tel" required></label><label>Service<select name="service"><option>Leak or repair</option><option>Blocked drain</option><option>Boiler repair</option><option>Bathroom installation</option><option>Other</option></select></label><label class="full">How can we help?<textarea name="message" placeholder="Tell us what needs fixing or installing" required></textarea></label><p class="full" id="quote-status" role="status" hidden>Thanks — this demonstration form is working. Live delivery details will be connected before launch.</p><button class="btn" type="submit">Request my quote</button></form>
<script>
  document.querySelector('#quote')?.addEventListener('submit', event => {
    event.preventDefault();
    const status = document.querySelector('#quote-status');
    if (status) status.hidden = false;
  });
</script>
